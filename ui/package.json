{
  "name": "halo-plugin-3d-ui",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "description": "Halo 3D 模型插件前端工程",
  "license": "GPL-3.0",
  "author": {
    "name": "FFeng123",
    "url": "https://github.com/FFeng123"
  },
  "homepage": "https://github.com/FFeng123/halo-plugin-3d#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/FFeng123/halo-plugin-3d.git"
  },
  "bugs": {
    "url": "https://github.com/FFeng123/halo-plugin-3d/issues"
  },
  "keywords": [
    "halo",
    "halo-plugin",
    "3d",
    "three.js",
    "gltf",
    "glb",
    "fbx",
    "obj"
  ],
  "scripts": {
    "dev": "vite build --watch --mode=development",
    "build": "npm-run-all --sequential build:*",
    "build:console": "vite build",
    "build:runtime": "vite build --config vite.runtime.config.ts",
    "type-check": "vue-tsc --noEmit -p tsconfig.json",
    "validate": "node ../scripts/validate-manifest.mjs",
    "package": "node ../scripts/package-plugin.mjs"
  },
  "dependencies": {
    "@halo-dev/api-client": "2.21.0",
    "@halo-dev/components": "2.21.0",
    "@halo-dev/console-shared": "2.21.0",
    "@halo-dev/richtext-editor": "2.21.0",
    "axios": "^1.7.2",
    "three": "^0.180.0",
    "vue": "^3.5.17"
  },
  "devDependencies": {
    "@halo-dev/ui-plugin-bundler-kit": "2.21.1",
    "@types/three": "^0.180.0",
    "@types/node": "^20.19.1",
    "@vitejs/plugin-vue": "^5.2.4",
    "js-yaml": "^4.1.0",
    "npm-run-all2": "^7.0.2",
    "typescript": "~5.8.3",
    "vite": "^5.3.2",
    "vue-tsc": "^2.2.10"
  }
}
